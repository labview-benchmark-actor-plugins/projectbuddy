{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ProjectBuddy Release Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "module",
    "source",
    "release",
    "toolchain",
    "artifacts",
    "dependencies",
    "validation"
  ],
  "properties": {
    "schemaVersion": { "const": "1.0" },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "id", "version"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "id": { "$ref": "#/definitions/nonBlankString" },
        "version": { "$ref": "#/definitions/nonBlankString" }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "ref", "commit"],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "ref": { "type": "string", "pattern": "^refs/tags/\\S+$" },
        "commit": {
          "type": "string",
          "pattern": "^(?:[A-Fa-f0-9]{40}|[A-Fa-f0-9]{64})$"
        }
      }
    },
    "release": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tag", "immutable"],
      "properties": {
        "tag": { "$ref": "#/definitions/nonBlankString" },
        "publishedAt": {
          "description": "Informational publication timestamp when known. GitHub release metadata is authoritative.",
          "type": "string",
          "format": "date-time"
        },
        "immutable": { "const": true },
        "url": { "type": "string", "format": "uri" }
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["labviewVersion", "labviewBitness", "vipmVersion", "runner"],
      "dependencies": {
        "labviewVilib": ["labviewBaseImageDigest"]
      },
      "properties": {
        "labviewVersion": { "$ref": "#/definitions/nonBlankString" },
        "labviewBitness": { "type": "string", "enum": ["32", "64"] },
        "vipmVersion": { "$ref": "#/definitions/nonBlankString" },
        "vipmDesktopVersion": { "$ref": "#/definitions/nonBlankString" },
        "labviewBaseImageDigest": {
          "type": "string",
          "pattern": "^nationalinstruments/labview@sha256:[A-Fa-f0-9]{64}$"
        },
        "labviewVilib": {
          "type": "object",
          "additionalProperties": false,
          "required": ["installedVersion", "source"],
          "properties": {
            "installedVersion": { "$ref": "#/definitions/nonBlankString" },
            "source": { "const": "preinstalled-base-image" }
          }
        },
        "runner": {
          "type": "object",
          "additionalProperties": false,
          "required": ["os", "class"],
          "properties": {
            "os": { "type": "string", "enum": ["windows", "linux", "macos"] },
            "class": { "type": "string", "enum": ["hosted", "self-hosted"] }
          }
        }
      }
    },
    "artifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["releaseAssets", "sboms"],
      "properties": {
        "releaseAssets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/releaseAssetProduct" }
        },
        "sboms": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/sbomArtifact" }
        },
        "attestation": { "$ref": "#/definitions/asset" }
      }
    },
    "dependencies": {
      "type": "array",
      "items": { "$ref": "#/definitions/dependency" }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "buildOutputs", "tests"],
      "properties": {
        "status": { "const": "passed" },
        "buildOutputs": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["buildSpec", "outputType", "outcome", "runUrl"],
            "properties": {
              "buildSpec": { "$ref": "#/definitions/nonBlankString" },
              "outputType": {
                "type": "string",
                "enum": ["executable", "source-distribution", "vip", "lvlibp", "vipc", "nipkg", "installer", "other"]
              },
              "outcome": { "type": "string", "enum": ["built", "executed"] },
              "includedInReleaseAsset": { "$ref": "#/definitions/safeFileName" },
              "runUrl": { "type": "string", "format": "uri" }
            },
            "allOf": [
              {
                "if": { "properties": { "outputType": { "const": "executable" } }, "required": ["outputType"] },
                "then": { "properties": { "outcome": { "const": "executed" } } }
              }
            ]
          }
        },
        "tests": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["name", "status"],
            "properties": {
              "name": { "$ref": "#/definitions/nonBlankString" },
              "status": { "const": "passed" },
              "runUrl": { "type": "string", "format": "uri" }
            }
          }
        }
      }
    }
  },
  "definitions": {
    "nonBlankString": { "type": "string", "pattern": "\\S" },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "sha256", "sizeBytes"],
      "properties": {
        "fileName": { "$ref": "#/definitions/safeFileName" },
        "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
        "sizeBytes": { "type": "integer", "minimum": 1 }
      }
    },
    "safeFileName": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._+-]*$"
    },
    "releaseAssetProduct": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version", "buildSpec", "kind", "format", "asset"],
      "properties": {
        "id": { "$ref": "#/definitions/nonBlankString" },
        "version": { "$ref": "#/definitions/nonBlankString" },
        "buildSpec": { "$ref": "#/definitions/nonBlankString" },
        "kind": {
          "type": "string",
          "enum": ["vip", "lvlibp", "executable", "source-distribution", "vipc", "nipkg", "installer", "other"]
        },
        "format": { "$ref": "#/definitions/nonBlankString" },
        "target": { "$ref": "#/definitions/nonBlankString" },
        "asset": { "$ref": "#/definitions/asset" }
      }
    },
    "sbomArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subjectAssetId", "subjectAssetVersion", "subjectAssetKind", "format", "specVersion", "asset"],
      "properties": {
        "subjectAssetId": { "$ref": "#/definitions/nonBlankString" },
        "subjectAssetVersion": { "$ref": "#/definitions/nonBlankString" },
        "subjectAssetKind": {
          "type": "string",
          "enum": ["vip", "lvlibp", "executable", "source-distribution", "vipc", "nipkg", "installer", "other"]
        },
        "format": { "const": "CycloneDX" },
        "specVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
        "asset": { "$ref": "#/definitions/asset" }
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ecosystem", "name", "version", "scope"],
      "properties": {
        "ecosystem": {
          "type": "string",
          "enum": ["vipm", "nipkg", "lvlibp", "labview-runtime", "git", "other"]
        },
        "name": { "$ref": "#/definitions/nonBlankString" },
        "version": { "$ref": "#/definitions/nonBlankString" },
        "scope": { "type": "string", "enum": ["build", "runtime"] },
        "repository": { "$ref": "#/definitions/nonBlankString" },
        "releaseTag": { "$ref": "#/definitions/nonBlankString" },
        "assetFileName": { "$ref": "#/definitions/safeFileName" },
        "stagePath": {
          "description": "Path relative to the consumer workflow checkout root, not the module checkout.",
          "allOf": [
            { "$ref": "#/definitions/safeRelativePath" },
            { "type": "string", "pattern": "\\.lvlibp$" }
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "ecosystem": { "const": "lvlibp" },
              "scope": { "const": "build" }
            },
            "required": ["ecosystem", "scope"]
          },
          "then": {
            "required": ["repository", "releaseTag", "assetFileName", "stagePath"]
          }
        }
      ]
    },
    "safeRelativePath": {
      "type": "string",
      "pattern": "^(?![\\\\/])(?![A-Za-z]:)(?!.*[<>:\"|?*\\x00-\\x1F])(?!.*(^|[\\\\/])\\.\\.([\\\\/]|$))\\S.*$"
    }
  }
}